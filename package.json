{
  "name": "@hashprivacy/elysium-connections-model",
  "version": "0.1.0",
  "private": true,
  "description": "Research reference model of value moving between Hyperliquid, HyperEVM and Hash Privacy on Elysium: canonical rollup messages, a spot transfer leg, shield-on-arrival routes and a relayer fast path. Not a working bridge.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HashPrivacyCC/elysium-connections-model"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:dashes": "bash scripts/check-dashes.sh",
    "example:hyperliquid-to-shielded": "npm run --silent build && node dist/examples/hyperliquid-to-shielded.js",
    "example:shielded-to-hyperevm": "npm run --silent build && node dist/examples/shielded-to-hyperevm.js",
    "example:fast-path-fallback": "npm run --silent build && node dist/examples/fast-path-fallback.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
